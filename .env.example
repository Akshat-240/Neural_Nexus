# Azure Computer Vision API credentials (for CV module visual analysis)
AZURE_CV_KEY=your_azure_computer_vision_key_here
AZURE_CV_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# (Optional) OpenAI API Key for AI extraction
# OPENAI_API_KEY=sk-...

# (Optional) Azure Speech keys for online STT
# AZURE_SPEECH_KEY=your_speech_key_here
# AZURE_SPEECH_REGION=eastus

# Azure Language Service API credentials
AZURE_LANGUAGE_KEY=your_azure_language_key_here
AZURE_LANGUAGE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure Translator API
AZURE_TRANSLATOR_KEY=your_translator_key
AZURE_TRANSLATOR_REGION=eastus
